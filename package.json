{
  "name": "containermc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth-schema.ts --yes"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.4",
    "@better-auth/stripe": "^1.7.4",
    "@icons-pack/svelte-simple-icons": "^7.2.0",
    "@sindresorhus/slugify": "^3.0.1",
    "@tanstack/svelte-form": "^1.33.5",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "mode-watcher": "^1.1.0",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0",
    "resend": "^6.27.0",
    "stripe": "^22.6.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@sveltejs/adapter-vercel": "^7.0.0-next.6",
    "@sveltejs/kit": "^3.0.0-next.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "auth": "^1.6.24",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "phosphor-svelte": "^3.1.0",
    "shadcn-svelte": "^1.6.1",
    "svelte": "^5.56.7",
    "svelte-check": "^4.6.0",
    "svelte-turnstile": "^0.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "overrides": {
    "drizzle-orm": "1.0.0-rc.4"
  }
}
